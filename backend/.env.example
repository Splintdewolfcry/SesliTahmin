# SesliTahmin backend environment example.
# Copy to `.env` and fill in real values. Never commit `.env`.

# ASR (speech-to-text) - defaults to Groq's OpenAI-compatible endpoint
ASR_BASE_URL=https://api.groq.com/openai/v1
ASR_API_KEY=
ASR_MODEL=whisper-large-v3

# LLM (text reasoning) - defaults to OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Simple shared auth token for the API surface
AUTH_TOKEN=

# Where the backend stores persisted artifacts (parquet files, etc.)
DATA_DIR=./data

# Exchange public market-data endpoints
BINANCE_BASE_URL=https://api.binance.com
BYBIT_BASE_URL=https://api.bybit.com

# In-process kline cache TTL (seconds)
KLINE_CACHE_TTL_SECONDS=30

# Comma-separated CORS origins. The backend list-parses this into a Python list.
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
